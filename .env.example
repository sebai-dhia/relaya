# ── Required ────────────────────────────────────────────────────
JWT_SECRET=local-dev-secret-not-for-production-use-at-least-256-bits-long-random

# ── AI Cost Guards ───────────────────────────────────────────────
MONTHLY_BUDGET_USD=5.00
MAX_TOKENS_PER_CALL=4000

# ── Data Retention ───────────────────────────────────────────────
RETENTION_DAYS=90

# ── CORS ─────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:4200

# ── Groq (fill in when available) ───────────────────────────────
GROQ_API_KEY=

SERVER_PORT=8082

# ── Trello (fill in when available) ─────────────────────────────
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=